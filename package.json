{
  "name": "bookmark-scout",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "nx run extension:dev",
    "dev:firefox": "nx run extension:dev:firefox",
    "dev:edge": "nx run extension:dev:edge",
    "build": "nx run extension:build",
    "build:firefox": "nx run extension:build:firefox",
    "build:edge": "nx run extension:build:edge",
    "build:all": "nx run-many --target=build --all",
    "lint": "nx run-many --target=lint --all",
    "test": "nx run extension:test",
    "test:unit": "nx run extension:test:unit",
    "test:e2e": "nx run extension:test:e2e",
    "dev:website": "nx run website:dev",
    "build:website": "nx run website:build",
    "dev:docs": "nx run docs:dev",
    "build:docs": "nx run docs:build",
    "graph": "nx graph",
    "generate:readme": "bun run scripts/generate-readme.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@tanstack/react-table": "^9.2.4",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@nx/js": "^23.2.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/selenium-webdriver": "^4.35.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "nx": "^23.2.1",
    "postcss": "^8.5.28",
    "selenium-webdriver": "^4.50.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "wxt": "^0.21.4"
  },
  "lint-staged": {
    "apps/extension/src/**/*.{ts,tsx}": [
      "bunx nx run extension:lint"
    ]
  }
}
