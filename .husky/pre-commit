bunx lint-staged

# README.md and translations/ are generated from templates/ and the site config.
# Regenerate and stage them whenever an input is part of the commit.
if git diff --cached --name-only | grep -qE '^(templates/|config/site\.config\.toml$|scripts/generate-readme\.ts$)'; then
  bun run generate:readme >/dev/null && git add README.md translations
fi
