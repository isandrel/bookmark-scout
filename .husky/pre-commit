bunx lint-staged

# README.md, CONTRIBUTING.md, DEVELOPMENT.md, and i18n/ are generated from templates/, the
# workspace config, and the installed package versions. Regenerate and stage them whenever an
# input is part of the commit; --list prints every output path.
if git diff --cached --name-only | grep -qE '^(templates/|config/|packages/config/|scripts/generate-markdown\.ts$|bun\.lock$|(apps/[^/]+/|packages/[^/]+/)?package\.json$)'; then
  bun run generate:markdown >/dev/null && bun run generate:markdown --list | xargs git add --
fi
