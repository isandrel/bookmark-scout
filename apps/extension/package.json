{
    "name": "@bookmark-scout/extension",
    "private": true,
    "version": "0.3.5",
    "type": "module",
    "scripts": {
        "dev": "wxt -b chrome",
        "dev:chrome": "wxt -b chrome",
        "dev:firefox": "wxt -b firefox",
        "dev:edge": "wxt -b edge",
        "build": "wxt build -b chrome && wxt build -b firefox && wxt build -b edge",
        "build:chrome": "wxt build -b chrome",
        "build:firefox": "wxt build -b firefox",
        "build:edge": "wxt build -b edge",
        "test": "bun run test:unit && bun run test:e2e",
        "test:unit": "vitest run --config vitest.config.ts",
        "test:coverage": "vitest run --config vitest.config.ts --coverage",
        "test:e2e:coverage": "rm -rf coverage/e2e && BS_E2E_COVERAGE=1 wxt build -b chrome && BS_E2E_COVERAGE=1 playwright test --config playwright.config.ts --project=chromium",
        "test:e2e": "bun run build:chrome && playwright install --with-deps --no-shell chromium && playwright test --config playwright.config.ts --project=chromium",
        "test:e2e:edge": "bun run build:edge && playwright test --config playwright.config.ts --project=edge",
        "test:e2e:firefox": "bun run build:firefox && playwright test --config playwright.config.ts --project=firefox",
        "zip": "wxt zip -b chrome && wxt zip -b firefox && wxt zip -b edge",
        "zip:chrome": "wxt zip -b chrome",
        "zip:firefox": "wxt zip -b firefox",
        "zip:edge": "wxt zip -b edge",
        "size:check": "bun scripts/check-distribution-size.ts",
        "bench:search": "vitest run --config tests/bench/vitest.config.ts",
        "lint": "biome check ./src ./tests ./build ./scripts/check-distribution-size.ts ./manifest.config.ts ./vitest.config.ts ./playwright.config.ts",
        "format": "biome format --write ./src",
        "check": "biome check --write ./src",
        "catalog:sync": "bun scripts/sync-provider-catalog.ts",
        "postinstall": "wxt prepare"
    },
    "devDependencies": {
        "@ai-sdk/provider": "^4.0.35",
        "@biomejs/biome": "catalog:",
        "@bookmark-scout/config": "workspace:*",
        "@playwright/test": "catalog:",
        "@tailwindcss/postcss": "catalog:",
        "@types/dom-chromium-ai": "^0.0.18",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@types/selenium-webdriver": "^4.35.7",
        "@types/turndown": "^5.0.6",
        "@vitejs/plugin-react": "^6.2.1",
        "@vitest/coverage-v8": "^5.1.0",
        "autoprefixer": "^10.6.2",
        "fake-indexeddb": "^6.2.7",
        "flexsearch": "^0.8.212",
        "linkedom": "^0.18.15",
        "minisearch": "^7.2.0",
        "monocart-coverage-reports": "^3.2.0",
        "postcss": "catalog:",
        "sass": "^1.108.0",
        "selenium-webdriver": "^4.52.0",
        "tailwindcss": "catalog:",
        "tw-animate-css": "^1.4.0",
        "typescript": "catalog:ts7",
        "vite": "^8.3.6",
        "vitest": "^5.1.0",
        "wxt": "^0.21.5"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^4.0.97",
        "@ai-sdk/azure": "^4.0.117",
        "@ai-sdk/deepseek": "^3.0.77",
        "@ai-sdk/google": "^4.0.112",
        "@ai-sdk/groq": "^4.0.77",
        "@ai-sdk/mistral": "^4.0.80",
        "@ai-sdk/openai": "^4.0.106",
        "@ai-sdk/openai-compatible": "^3.0.85",
        "@ai-sdk/react": "^4.0.167",
        "@ai-sdk/xai": "^5.0.39",
        "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
        "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "3.2.1",
        "@atlaskit/pragmatic-drag-and-drop-hitbox": "3.0.0",
        "@atlaskit/pragmatic-drag-and-drop-live-region": "2.1.0",
        "@atlaskit/pragmatic-drag-and-drop-react-drop-indicator": "4.2.4",
        "@base-ui/react": "^1.9.0",
        "@bookmark-scout/mcp-bridge": "workspace:*",
        "@earendil-works/chord": "1.5.0",
        "@earendil-works/pi-ai": "1.5.0",
        "@earendil-works/pi-durable": "1.5.0",
        "@fontsource-variable/bricolage-grotesque": "^5.3.0",
        "@fontsource-variable/instrument-sans": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@mozilla/readability": "^0.6.0",
        "@tanstack/react-table": "^9.3.1",
        "@tanstack/react-virtual": "^3.14.26",
        "agent-skills-ts-sdk": "^2.5.0",
        "ai": "^7.0.159",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "idb": "^8.0.4",
        "lucide-react": "catalog:",
        "next-themes": "^0.4.6",
        "ollama-ai-provider-v2": "^4.1.0",
        "react": "catalog:",
        "react-day-picker": "^10.0.2",
        "react-dom": "catalog:",
        "react-json-view-lite": "^2.5.0",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "smol-toml": "catalog:",
        "tailwind-merge": "^3.7.0",
        "turndown": "^7.2.5",
        "zod": "catalog:",
        "zustand": "^5.1.0"
    }
}
