{
    "name": "@bookmark-scout/extension",
    "private": true,
    "version": "0.2.0",
    "type": "module",
    "scripts": {
        "dev": "wxt -b chrome",
        "dev:chrome": "wxt -b chrome",
        "dev:firefox": "wxt -b firefox",
        "dev:edge": "wxt -b edge",
        "build": "wxt build -b chrome && wxt build -b firefox && wxt build -b edge",
        "build:chrome": "wxt build -b chrome",
        "build:firefox": "wxt build -b firefox",
        "build:edge": "wxt build -b edge",
        "test": "bun run test:unit && bun run test:e2e",
        "test:unit": "vitest run --config vitest.config.ts",
        "test:e2e": "bun run build:chrome && playwright install --with-deps chromium && playwright test --config playwright.config.ts",
        "zip": "wxt zip -b chrome && wxt zip -b firefox && wxt zip -b edge",
        "zip:chrome": "wxt zip -b chrome",
        "zip:firefox": "wxt zip -b firefox",
        "zip:edge": "wxt zip -b edge",
        "lint": "biome lint ./src ./tests ./vitest.config.ts ./playwright.config.ts",
        "format": "biome format --write ./src",
        "check": "biome check --write ./src",
        "postinstall": "wxt prepare"
    },
    "devDependencies": {
        "sass": "^1.105.0"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^4.0.60",
        "@ai-sdk/deepseek": "^3.0.50",
        "@ai-sdk/google": "^4.0.77",
        "@ai-sdk/groq": "^4.0.46",
        "@ai-sdk/mistral": "^4.0.48",
        "@ai-sdk/openai": "^4.0.72",
        "@hookform/resolvers": "^5.9.1",
        "@radix-ui/react-slider": "^1.4.7",
        "@radix-ui/react-tabs": "^1.1.21",
        "@webext-core/storage": "^2.0.0",
        "ai": "^7.0.111",
        "next-themes": "^0.4.6",
        "ollama-ai-provider": "^1.2.0",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "react-hook-form": "^7.88.0",
        "react-json-view-lite": "^2.5.0",
        "smol-toml": "^1.9.0",
        "zod": "^4.6.5"
    }
}
