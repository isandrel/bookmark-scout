{
    "name": "@bookmark-scout/extension",
    "private": true,
    "version": "0.2.0",
    "type": "module",
    "scripts": {
        "dev": "wxt -b chrome",
        "dev:chrome": "wxt -b chrome",
        "dev:firefox": "wxt -b firefox",
        "dev:edge": "wxt -b edge",
        "build": "wxt build -b chrome && wxt build -b firefox && wxt build -b edge",
        "build:chrome": "wxt build -b chrome",
        "build:firefox": "wxt build -b firefox",
        "build:edge": "wxt build -b edge",
        "test": "bun run test:unit && bun run test:e2e",
        "test:unit": "vitest run --config vitest.config.ts",
        "test:e2e": "bun run build:chrome && playwright install --with-deps chromium && playwright test --config playwright.config.ts --project=chromium",
        "test:e2e:edge": "bun run build:edge && playwright test --config playwright.config.ts --project=edge",
        "test:e2e:firefox": "bun run build:firefox && playwright test --config playwright.config.ts --project=firefox",
        "zip": "wxt zip -b chrome && wxt zip -b firefox && wxt zip -b edge",
        "zip:chrome": "wxt zip -b chrome",
        "zip:firefox": "wxt zip -b firefox",
        "zip:edge": "wxt zip -b edge",
        "lint": "biome lint ./src ./tests ./vitest.config.ts ./playwright.config.ts",
        "format": "biome format --write ./src",
        "check": "biome check --write ./src",
        "catalog:sync": "bun scripts/sync-provider-catalog.ts",
        "postinstall": "wxt prepare"
    },
    "devDependencies": {
        "@types/turndown": "^5.0.6",
        "linkedom": "^0.18.13",
        "sass": "^1.105.0",
        "tw-animate-css": "^1.4.0"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^4.0.60",
        "@ai-sdk/azure": "^4.0.90",
        "@ai-sdk/deepseek": "^3.0.50",
        "@ai-sdk/google": "^4.0.77",
        "@ai-sdk/groq": "^4.0.46",
        "@ai-sdk/mistral": "^4.0.48",
        "@ai-sdk/openai": "^4.0.72",
        "@ai-sdk/openai-compatible": "^3.0.62",
        "@ai-sdk/xai": "^5.0.14",
        "@base-ui/react": "^1.8.0",
        "@fontsource-variable/bricolage-grotesque": "^5.3.0",
        "@fontsource-variable/instrument-sans": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@hookform/resolvers": "^5.9.1",
        "@mozilla/readability": "^0.6.0",
        "ai": "^7.0.111",
        "next-themes": "^0.4.6",
        "ollama-ai-provider-v2": "^4.0.1",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "react-hook-form": "^7.88.0",
        "react-json-view-lite": "^2.5.0",
        "smol-toml": "^1.9.0",
        "turndown": "^7.2.4",
        "zod": "^4.6.5"
    }
}
