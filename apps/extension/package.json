{
    "name": "@bookmark-scout/extension",
    "private": true,
    "version": "0.3.5",
    "type": "module",
    "scripts": {
        "dev": "wxt -b chrome",
        "dev:chrome": "wxt -b chrome",
        "dev:firefox": "wxt -b firefox",
        "dev:edge": "wxt -b edge",
        "build": "wxt build -b chrome && wxt build -b firefox && wxt build -b edge",
        "build:chrome": "wxt build -b chrome",
        "build:firefox": "wxt build -b firefox",
        "build:edge": "wxt build -b edge",
        "test": "bun run test:unit && bun run test:e2e",
        "test:unit": "vitest run --config vitest.config.ts",
        "test:coverage": "vitest run --config vitest.config.ts --coverage",
        "test:e2e:coverage": "rm -rf coverage/e2e && BS_E2E_COVERAGE=1 wxt build -b chrome && BS_E2E_COVERAGE=1 playwright test --config playwright.config.ts --project=chromium",
        "test:e2e": "bun run build:chrome && playwright install --with-deps --no-shell chromium && playwright test --config playwright.config.ts --project=chromium",
        "test:e2e:edge": "bun run build:edge && playwright test --config playwright.config.ts --project=edge",
        "test:e2e:firefox": "bun run build:firefox && playwright test --config playwright.config.ts --project=firefox",
        "zip": "wxt zip -b chrome && wxt zip -b firefox && wxt zip -b edge",
        "zip:chrome": "wxt zip -b chrome",
        "zip:firefox": "wxt zip -b firefox",
        "zip:edge": "wxt zip -b edge",
        "size:check": "bun scripts/check-distribution-size.ts",
        "bench:search": "vitest run --config tests/bench/vitest.config.ts",
        "lint": "biome check ./src ./tests ./build ./scripts/check-distribution-size.ts ./manifest.config.ts ./vitest.config.ts ./playwright.config.ts",
        "format": "biome format --write ./src",
        "check": "biome check --write ./src",
        "catalog:sync": "bun scripts/sync-provider-catalog.ts",
        "postinstall": "wxt prepare"
    },
    "devDependencies": {
        "@ai-sdk/provider": "^4.0.26",
        "@biomejs/biome": "^2.5.15",
        "@bookmark-scout/config": "workspace:*",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/dom-chromium-ai": "^0.0.17",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/selenium-webdriver": "^4.35.7",
        "@types/turndown": "^5.0.6",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/coverage-v8": "^5.0.5",
        "autoprefixer": "^10.6.1",
        "fake-indexeddb": "^6.2.6",
        "flexsearch": "^0.8.212",
        "linkedom": "^0.18.14",
        "minisearch": "^7.2.0",
        "monocart-coverage-reports": "^3.0.0",
        "postcss": "^8.5.31",
        "sass": "^1.106.1",
        "selenium-webdriver": "^4.51.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5",
        "wxt": "^0.21.4"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^4.0.87",
        "@ai-sdk/azure": "^4.0.109",
        "@ai-sdk/deepseek": "^3.0.58",
        "@ai-sdk/google": "^4.0.104",
        "@ai-sdk/groq": "^4.0.69",
        "@ai-sdk/mistral": "^4.0.71",
        "@ai-sdk/openai": "^4.0.83",
        "@ai-sdk/openai-compatible": "^3.0.77",
        "@ai-sdk/react": "^4.0.154",
        "@ai-sdk/xai": "^5.0.29",
        "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
        "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "3.2.1",
        "@atlaskit/pragmatic-drag-and-drop-hitbox": "3.0.0",
        "@atlaskit/pragmatic-drag-and-drop-live-region": "2.1.0",
        "@atlaskit/pragmatic-drag-and-drop-react-drop-indicator": "4.2.4",
        "@base-ui/react": "^1.9.0",
        "@bookmark-scout/mcp-bridge": "workspace:*",
        "@fontsource-variable/bricolage-grotesque": "^5.3.0",
        "@fontsource-variable/instrument-sans": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@mozilla/readability": "^0.6.0",
        "@tanstack/react-table": "^9.3.1",
        "@tanstack/react-virtual": "^3.14.22",
        "ai": "^7.0.127",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "idb": "^8.0.4",
        "lucide-react": "^1.61.0",
        "next-themes": "^0.4.6",
        "ollama-ai-provider-v2": "^4.1.0",
        "react": "^19.3.1",
        "react-day-picker": "^10.0.2",
        "react-dom": "^19.3.1",
        "react-json-view-lite": "^2.5.0",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "smol-toml": "^1.9.1",
        "tailwind-merge": "^3.7.0",
        "turndown": "^7.2.4",
        "zod": "^4.6.7",
        "zustand": "^5.0.16"
    }
}
