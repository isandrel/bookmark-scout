{
    "name": "website",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/website/app",
    "tags": [
        "scope:website",
        "type:app"
    ],
    "targets": {
        "dev": {
            "command": "bun scripts/optimize-images.ts && next dev",
            "options": {
                "cwd": "apps/website"
            }
        },
        "build": {
            "command": "bun scripts/optimize-images.ts && next build",
            "options": {
                "cwd": "apps/website"
            }
        },
        "start": {
            "command": "next start",
            "options": {
                "cwd": "apps/website"
            }
        },
        "lint": {
            "command": "eslint",
            "options": {
                "cwd": "apps/website"
            }
        },
        "verify": {
            "command": "bun scripts/verify-build.ts",
            "dependsOn": [
                "build"
            ],
            "options": {
                "cwd": "apps/website"
            }
        },
        "test:e2e": {
            "command": "bunx playwright test",
            "dependsOn": [
                "build"
            ],
            "options": {
                "cwd": "apps/website"
            }
        }
    }
}
